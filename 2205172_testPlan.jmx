            <stringProp name="GraphQLHTTPSampler.query">
    query PrivacyPrompt {
        privacyPrompt(input: {type: CONSENT_PRIMARY}) {
            privacyPrompt {
                id
                customizeUrl
                promptMarkdown {
                    value {
                        plainText
                        plaidHtml(queryParams:&quot;ref_=cb_text_link&quot;)
                    }
                }
                acceptButtonLabel {
                    text
                }
                rejectButtonLabel {
                    text
                }
                customizeButtonLabel {
                    text
                }
                showPromptOnPageLoad
            }
        }
        privacyDirectives {
            directives {
                directivesCookie
                expirationDate
                vendors {
                    id
                    allow
                }
            }
        }
    }
</stringProp>
